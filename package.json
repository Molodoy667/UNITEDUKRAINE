{
  "name": "united-ukraine-roleplay",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "deploy:build": "npm run forum:migrate && npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "db:generate": "drizzle-kit generate",
    "forum:api": "node --env-file-if-exists=.env.forum.local scripts/forum-dev.mjs",
    "forum:migrate": "node --env-file-if-exists=.env.forum.local scripts/forum-manage.mjs migrate",
    "forum:owner": "node --env-file-if-exists=.env.forum.local scripts/forum-manage.mjs owner",
    "forum:cleanup": "node --env-file-if-exists=.env.forum.local scripts/forum-manage.mjs cleanup",
    "test:forum": "node tests/forum.test.mjs",
    "test:account": "node tests/account.test.mjs",
    "test:roulette": "node tests/roulette.integration.mjs",
    "test:forbes": "node tests/forbes.test.mjs",
    "test:forbes:integration": "node tests/forbes.integration.mjs",
    "test:admin": "node tests/admin.test.mjs",
    "test:admin:integration": "node tests/admin.integration.mjs",
    "test:admin:bridge": "node tests/admin-bridge.test.mjs",
    "test:site": "node tests/site.test.mjs",
    "test:site:integration": "node tests/site.integration.mjs",
    "test:forum:integration": "node tests/forum.integration.mjs",
    "forum:mail": "node --env-file-if-exists=.env.forum.local scripts/forum-mail.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "mysql2": "^3.24.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
