{
  "framework": "vite",
  "buildCommand": "npm run deploy:build",
  "outputDirectory": "dist",
  "functions": {
    "api/render.js": { "includeFiles": "dist/index.html" }
  },
  "env": {
    "ADMIN_BRIDGE_ID": "united-main"
  },
  "rewrites": [
    { "source": "/online.json", "destination": "/api/server?format=online" },
    { "source": "/api/knowledge-base", "destination": "/api/site?kbRoute=not-found" },
    { "source": "/api/knowledge-base/categories", "destination": "/api/site?kbRoute=categories" },
    { "source": "/api/knowledge-base/posts/:categoryId", "destination": "/api/site?kbRoute=posts/:categoryId" },
    { "source": "/api/knowledge-base/search", "destination": "/api/site?kbRoute=search" },
    { "source": "/api/knowledge-base/:path*", "destination": "/api/site?kbRoute=not-found" },
    { "source": "/projects/crmp/v2/info.xml", "destination": "/api/server?format=discord" },
    { "source": "/", "destination": "/api/render?path=/" },
    { "source": "/contacts", "destination": "/api/render?path=/contacts" },
    { "source": "/terms", "destination": "/api/render?path=/terms" },
    { "source": "/privacy", "destination": "/api/render?path=/privacy" },
    { "source": "/p/:slug", "destination": "/api/render?path=/p/:slug" },
    { "source": "/news/:slug", "destination": "/api/render?path=/news/:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
