{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./*"] },
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "components/site-shell.tsx"],
  "exclude": ["node_modules", "examples", "build", "db", "drizzle"]
}
