# Copy to .env.forum.local for local operator commands; configure the same keys in Vercel.
# Never commit the populated file. Use a database account limited to the forum database.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
FORUM_ORIGIN=https://united-rp.com.ua
# Generate each value separately using node -p "require('crypto').randomBytes(32).toString('hex')"
FORUM_IP_SECRET=
FORUM_ENCRYPTION_KEY=
FORUM_CRON_SECRET=
# Verified sending domain and sender in Resend. Required to open public registration.
RESEND_API_KEY=
FORUM_MAIL_FROM=
# Separate PRIVATE R2 bucket. Never use a public launcher-download bucket for forum evidence.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FORUM_BUCKET=
# Bootstrap only; keep these operator values off Vercel and remove after setup.
FORUM_OWNER_USERNAME=
FORUM_OWNER_EMAIL=
FORUM_OWNER_PASSWORD=
